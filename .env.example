# 이 파일을 .env.local 로 복사해 값을 채우세요. 실제 값이 들어간 .env / .env.local 은 git에 올리지 마세요.

# MongoDB 연결 문자열 (로컬 또는 Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/todo-app

# GitHub OAuth App 자격 증명 (생성 방법은 README의 "GitHub 로그인 설정" 참고)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 앱의 공개 주소. OAuth callback(redirect_uri)은 항상 {APP_URL}/auth/github/callback 으로 만들어집니다.
# GitHub OAuth App 에 등록한 Authorization callback URL 과 정확히 같아야 합니다.
APP_URL=http://localhost:3000
